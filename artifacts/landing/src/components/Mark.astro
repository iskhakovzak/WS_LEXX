---
// WS_Desk mark "One line" (edge-tracker components/ds/brand.tsx): the W's fourth stroke becomes the S.
// `inline` returns the bare path for use inside another SVG (the brand roundel).
interface Props { size?: number; inline?: boolean; width?: number }
const { size = 28, inline = false, width = 7 } = Astro.props;
const d = "M6.5 17L15.5 46L24.5 23.5L33.5 46C38 50.5 56 50 56.5 40.5C57 31.5 40.5 34 40.5 25.5C40.5 16.5 54.5 15.5 57.5 21";
---
{inline
  ? <path d={d} fill="none" stroke="currentColor" stroke-width={width} stroke-linecap="round" stroke-linejoin="round" />
  : (
    <svg width={size} height={size} viewBox="1.07 0.41 61.87 61.87" aria-hidden="true" focusable="false">
      <path d={d} fill="none" stroke="currentColor" stroke-width={width} stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )}
