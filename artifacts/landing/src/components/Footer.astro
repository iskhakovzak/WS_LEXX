---
import Mark from "./Mark.astro";
import { LEGAL, isPlaceholder } from "../site.config";
import { t, pathFor, type Locale } from "../i18n";

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);
const year = new Date().getFullYear();
const email = isPlaceholder(LEGAL.contactEmail) ? null : LEGAL.contactEmail;
const entity = isPlaceholder(LEGAL.entity) ? "WS_DeskOS" : LEGAL.entity;
---
<footer class="foot">
  <p class="foot-name blend"><Mark size={64} width={5} /><span>WS_DeskOS</span></p>
  <div class="foot-row">
    <p class="ui muted blend">{d.footer.tagline}</p>
    <nav aria-label="Legal" class="foot-links ui">
      <a href={pathFor(locale, "terms")}>{d.footer.terms} <span aria-hidden="true">-&gt;</span></a>
      <a href={pathFor(locale, "privacy")}>{d.footer.privacy} <span aria-hidden="true">-&gt;</span></a>
      <a href={pathFor(locale, "refund")}>{d.footer.refund} <span aria-hidden="true">-&gt;</span></a>
      {email && <a href={`mailto:${email}`}>{d.footer.contact} <span aria-hidden="true">-&gt;</span></a>}
    </nav>
  </div>
  <p class="foot-copy ui muted">&copy; {year} {entity}. {d.footer.rights}</p>
</footer>

<style>
  .foot { max-width: var(--max); margin: var(--section) auto 0; padding: 48px var(--edge) 32px; border-top: 1px solid var(--line); }
  .foot-name { display: flex; align-items: center; gap: clamp(12px, 2vw, 24px); font-size: clamp(2.5rem, 9.5vw, 8.5rem); line-height: 1; color: #fff; letter-spacing: -0.04em; text-transform: uppercase; overflow: hidden; }
  .foot-name :global(svg) { width: 0.7em; height: 0.7em; flex: none; }
  .foot-row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px 32px; margin-top: 40px; }
  .foot-links { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .foot-links a { text-decoration: none; color: var(--text); transition: opacity 300ms; }
  .foot-links a:hover { opacity: 0.7; text-decoration: underline; }
  .foot-copy { margin-top: 24px; font-size: 11px; }
</style>
