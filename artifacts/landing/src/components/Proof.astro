---
// Real desk aggregates and product screenshots (site.config.ts). Each block is built only when its content is
// filled in; PUBLIC_SHOW_PLACEHOLDERS=1 shows the raw placeholders for a local preview.
import { NUMBERS, SHOW_PLACEHOLDERS, isPlaceholder } from "../site.config";
import { screens as allScreens } from "../lib/screens";
import { t, type Locale } from "../i18n";

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);

const figures = [
  { value: NUMBERS.savedUsd, label: d.numbers.saved, up: true },
  { value: NUMBERS.alertsFired, label: d.numbers.alerts, up: false },
  { value: NUMBERS.tradersOnDesk, label: d.numbers.traders, up: false },
  { value: NUMBERS.sessionsTracked, label: d.numbers.sessions, up: false },
];
const numbersFilled = figures.every((f) => !isPlaceholder(f.value));
const showNumbers = numbersFilled || SHOW_PLACEHOLDERS;
const period = isPlaceholder(NUMBERS.period) && !SHOW_PLACEHOLDERS ? "" : NUMBERS.period;
const screens = allScreens.filter((s) => s.hero && (s.exists || SHOW_PLACEHOLDERS));
// The first shot spans the content column, the rest take half of it from 900 px.
const sizes = (i: number) => (i === 0 ? "(min-width: 1440px) 1030px, (min-width: 900px) calc(100vw - 440px), calc(100vw - 54px)" : "(min-width: 1440px) 505px, (min-width: 900px) calc(50vw - 230px), calc(100vw - 54px)");
const two = (n: number) => String(n).padStart(2, "0");
---
{showNumbers && (
  <section class="sec numbers" aria-labelledby="numbers-title">
    <div class="sec-side blend"><p class="kick">[{d.ui.kick.numbers}]</p></div>
    <div>
      <h2 id="numbers-title" class="sec-title blend" data-reveal>{d.numbers.title}{period && <span class="period">{period}</span>}</h2>
      <dl class="figs blend">
        {figures.map((f, i) => (
          <div data-reveal style={`--i:${i}`}>
            <dt class="visually-hidden">{f.label}</dt>
            <dd class:list={["fig num", f.up && "fig-up"]}>{f.value}</dd>
            <dd class="fig-label ui muted">{f.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
)}

{screens.length > 0 && (
  <section class="sec screens" aria-labelledby="screens-title">
    <div class="sec-side blend"><p class="kick">[{d.ui.kick.screens}]</p></div>
    <div>
      <h2 id="screens-title" class="sec-title blend" data-reveal>{d.screens.title}</h2>
      <div class="shots">
        {screens.map((s, i) => (
          <figure data-reveal style={`--i:${i % 2}`}>
            {s.exists
              ? <img src={s.src} srcset={s.srcset} sizes={sizes(i)} alt={d.screens.alt[s.id]} width="1600" height="1000" loading="lazy" decoding="async" />
              : <div class="slot" role="img" aria-label={`${d.screens.pending}: ${d.screens.items[s.id]}`}>{d.screens.pending}: {s.src}</div>}
            <figcaption class="meta">
              <span>{d.screens.items[s.id]}</span>
              <span class="muted">{two(i + 1)} / {two(screens.length)}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .period { color: var(--muted); margin-left: 0.5em; overflow-wrap: anywhere; }
  .figs { display: grid; grid-template-columns: 1fr 1fr; gap: 40px 24px; margin-top: 48px; }
  .figs > div { min-width: 0; border-top: 1px solid var(--line); padding-top: 18px; }
  .fig { overflow-wrap: anywhere; font-size: clamp(2.25rem, 5vw, 4.5rem); line-height: 1; color: #fff; letter-spacing: -0.03em; }
  .fig-up { color: var(--up); }
  .fig-label { margin-top: 12px; }
  @media (min-width: 1000px) { .figs { grid-template-columns: repeat(4, 1fr); } }

  /* Screenshots sit on opaque cards: no blend. */
  .shots { display: grid; gap: 24px; margin-top: 48px; }
  .shots figure { margin: 0; background: var(--card); border: 1px solid var(--line); padding: 10px; }
  .shots img, .slot { width: 100%; aspect-ratio: 16 / 10; border-radius: 2px; background: var(--card); object-fit: cover; object-position: top left; }
  .slot { display: grid; place-items: center; padding: 24px; text-align: center; color: var(--muted); text-transform: uppercase; outline: 1px dashed var(--line-2); outline-offset: -1px; }
  .meta { display: flex; justify-content: space-between; gap: 16px; margin-top: 10px; font-size: 12px; text-transform: uppercase; color: #fff; }
  @media (min-width: 900px) { .shots { grid-template-columns: 1fr 1fr; } .shots figure:first-child { grid-column: 1 / -1; } }
</style>
