modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "gce"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/api-server: API Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/edge-tracker: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Binance News Monitor"

[[workflows.workflow]]
name = "artifacts/api-server: API Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8080 pnpm --filter @workspace/api-server run dev"
waitForPort = 8080

[[workflows.workflow]]
name = "artifacts/edge-tracker: web"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/edge-tracker run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Binance News Monitor"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/binance-monitor && python3 main.py"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 19400
externalPort = 8008

[[ports]]
localPort = 22320
externalPort = 8099

[[ports]]
localPort = 23982
externalPort = 4200

[[ports]]
localPort = 24402
externalPort = 80

[[ports]]
localPort = 24403
externalPort = 3000

[[ports]]
localPort = 24404
externalPort = 3001

[[ports]]
localPort = 24405
externalPort = 3002

[[ports]]
localPort = 24406
externalPort = 3003

[nix]
channel = "stable-25_05"

[userenv]

[userenv.production]
TELEGRAM_WEBHOOK_URL = "https://zakit.website/api/telegram/webhook"

[userenv.shared]
TELEGRAM_CHAT_ID = "-1003858687114"

[objectStorage]
defaultBucketID = "replit-objstore-45151b94-ae10-4ae7-8eaa-4b3957c07d0a"
